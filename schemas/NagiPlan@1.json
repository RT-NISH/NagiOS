{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nagi-os.dev/schemas/NagiPlan@1.json",
  "title": "NagiPlan@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["plan_version", "intent", "steps"],
  "properties": {
    "plan_version": { "const": 1 },
    "intent": { "type": "string", "minLength": 1, "maxLength": 128 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action"],
        "properties": {
          "action": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+(\\.[a-z0-9_-]+)*$",
            "maxLength": 96
          },
          "object_ids": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 }
          },
          "parameters": {
            "type": "object",
            "maxProperties": 32,
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9_]*$",
              "not": { "pattern": "(path|command|shell|argv|script|executable)" }
            },
            "additionalProperties": {
              "type": ["string", "integer", "boolean"]
            }
          }
        }
      }
    }
  }
}
