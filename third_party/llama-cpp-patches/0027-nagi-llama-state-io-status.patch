+class test_state_io_reader : public llama_io_read_i {
+public:
+    test_state_io_reader(const uint8_t * data, size_t size) : data(data), size(size) {}
+
+    void read(void * dst, size_t read_size) override {
+        if (failed()) {
+            if (dst != nullptr && read_size != 0) {
+                std::memset(dst, 0, read_size);
+            }
+            return;
+        }
+        if (read_size > size - position || (read_size != 0 && dst == nullptr)) {
+            fail("unexpectedly reached end of fixture buffer");
+            if (dst != nullptr && read_size != 0) {
+                std::memset(dst, 0, read_size);
+            }
+            return;
+        }
+        if (read_size != 0) {
+            std::memcpy(dst, data + position, read_size);
+        }
+        position += read_size;
+    }
+
+    void read_tensor(ggml_tensor *, size_t, size_t) override {}
+    size_t n_bytes() override { return position; }
+
+private:
+    const uint8_t * data;
+    size_t size;
+    size_t position = 0;
+};
+
+static bool state_io_short_string_returns_failure() {
+    const uint8_t empty_string_length[] = { 0, 0, 0, 0 };
+    test_state_io_reader empty_reader(empty_string_length, sizeof(empty_string_length));
+    std::string empty_value = "not empty";
+    if (!empty_reader.read_string(empty_value) || empty_reader.failed() || !empty_value.empty() ||
+            empty_reader.n_bytes() != sizeof(empty_string_length)) {
+        std::fprintf(stderr, "empty state string did not decode safely\n");
+        return false;
+    }
+
+    const uint8_t truncated_length[] = { 4, 0 };
+    test_state_io_reader short_reader(truncated_length, sizeof(truncated_length));
+    std::string value = "preserved";
+#ifdef __NAGI__
+    if (short_reader.read_string(value) || !short_reader.failed() || short_reader.n_bytes() != 0) {
+        std::fprintf(stderr, "truncated state string length did not return checked failure\n");
+        return false;
+    }
+#else
+    bool short_threw = false;
+    try {
+        (void) short_reader.read_string(value);
+    } catch (const std::runtime_error &) {
+        short_threw = true;
+    }
+    if (!short_threw) {
+        std::fprintf(stderr, "truncated host state string changed its exception contract\n");
+        return false;
+    }
+#endif
+
+    const uint32_t oversized_length = 4097;
+    uint8_t oversized_header[sizeof(oversized_length)] = {};
+    std::memcpy(oversized_header, &oversized_length, sizeof(oversized_length));
+    test_state_io_reader oversized_reader(oversized_header, sizeof(oversized_header));
+#ifdef __NAGI__
+    if (oversized_reader.read_string(value) || !oversized_reader.failed() || oversized_reader.n_bytes() != sizeof(oversized_header)) {
+        std::fprintf(stderr, "oversized state string did not fail before allocation\n");
+        return false;
+    }
+#else
+    bool oversized_threw = false;
+    try {
+        (void) oversized_reader.read_string(value);
+    } catch (const std::runtime_error &) {
+        oversized_threw = true;
+    }
+    if (!oversized_threw) {
+        std::fprintf(stderr, "oversized host state string changed its exception contract\n");
+        return false;
+    }
+#endif
+    return true;
+}
