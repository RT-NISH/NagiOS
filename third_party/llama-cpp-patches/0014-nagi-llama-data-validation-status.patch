+static bool invalid_tensor_data_status() {
+    FILE * file = std::tmpfile();
+    if (file == nullptr) {
+        std::fprintf(stderr, "cannot create invalid tensor-data fixture\n");
+        return false;
+    }
+
+    ggml_init_params params = {
+        /*.mem_size   =*/ 4 * ggml_tensor_overhead(),
+        /*.mem_buffer =*/ nullptr,
+        /*.no_alloc   =*/ true,
+    };
+    ggml_context * source_ctx = ggml_init(params);
+    gguf_context * metadata = gguf_init_empty();
+    if (source_ctx == nullptr || metadata == nullptr) {
+        std::fprintf(stderr, "cannot allocate invalid tensor-data fixture\n");
+        ggml_free(source_ctx);
+        gguf_free(metadata);
+        std::fclose(file);
+        return false;
+    }
+
+    gguf_set_val_str(metadata, "general.architecture", "llama");
+    ggml_tensor * source_tensor = ggml_new_tensor_1d(source_ctx, GGML_TYPE_F16, 1);
+    ggml_set_name(source_tensor, "invalid_tensor");
+    gguf_add_tensor(metadata, source_tensor);
+    const uint16_t infinity = 0x7c00;
+    gguf_set_tensor_data(metadata, "invalid_tensor", &infinity);
+    const bool written = gguf_write_to_file_ptr(metadata, file, false);
+    ggml_free(source_ctx);
+    gguf_free(metadata);
+    if (!written || std::fseek(file, 0, SEEK_SET) != 0) {
+        std::fprintf(stderr, "cannot write invalid tensor-data fixture\n");
+        std::fclose(file);
+        return false;
+    }
+
+    std::vector<std::string> splits;
+    bool failed_closed = false;
+    try {
+        llama_model_loader loader(nullptr, nullptr, nullptr, "", splits, file,
+                LLAMA_LOAD_MODE_NONE, true, false, false, nullptr, nullptr);
+        ggml_backend_t backend = ggml_backend_cpu_init();
+        if (backend == nullptr) {
+            std::fprintf(stderr, "cannot initialize CPU backend for invalid tensor-data fixture\n");
+            std::fclose(file);
+            return false;
+        }
+        ggml_context * ctx = loader.contexts.front().get();
+        ggml_backend_buffer_t buffer = ggml_backend_alloc_ctx_tensors(ctx, backend);
+        if (buffer == nullptr) {
+            std::fprintf(stderr, "cannot allocate tensor-data fixture backend buffer\n");
+            ggml_backend_free(backend);
+            std::fclose(file);
+            return false;
+        }
+        loader.init_mappings(false, nullptr);
+
+        llama_buf_map bufs;
+        bool loaded = true;
+        bool threw = false;
+        try {
+            loaded = loader.load_all_data(ctx, bufs, nullptr, nullptr, nullptr);
+        } catch (const std::exception & error) {
+            threw = true;
+#ifdef __NAGI__
+            std::fprintf(stderr, "invalid tensor data threw under __NAGI__: %s\n", error.what());
+#endif
+        }
+#ifdef __NAGI__
+        failed_closed = !threw && !loaded && !loader.loader_valid;
+#else
+        failed_closed = threw && loaded && loader.loader_valid;
+#endif
+        ggml_backend_buffer_free(buffer);
+        ggml_backend_free(backend);
+    } catch (const std::exception & error) {
+        std::fprintf(stderr, "invalid tensor-data fixture setup failed: %s\n", error.what());
+    }
+    std::fclose(file);
+    if (!failed_closed) {
+        std::fprintf(stderr, "invalid tensor data did not reach the loader failure status\n");
+    }
