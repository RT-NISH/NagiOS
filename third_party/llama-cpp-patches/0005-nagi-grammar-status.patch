+static void test_failed_grammar_blocks_all_candidates() {
+    auto * grammar = build_grammar("root ::= \"a\"\n");
+    assert(grammar != nullptr);
+    assert(!llama_grammar_accept_token(*grammar, 0, "b"));
+    assert(grammar->failed);
+
+    llama_token_data candidates[] = {
+        {0, 0.0f, 0.0f},
+        {1, 1.0f, 0.0f},
+    };
+    llama_token_data_array cur_p = {
+        /* .data     = */ candidates,
+        /* .size     = */ 2,
+        /* .selected = */ -1,
+        /* .sorted   = */ false,
+    };
+    llama_grammar_apply_impl(*grammar, &cur_p);
+
+    for (const auto & candidate : candidates) {
+        assert(candidate.id == LLAMA_TOKEN_NULL);
+        assert(std::isinf(candidate.logit) && candidate.logit < 0.0f);
+    }
+
+    auto * clone = llama_grammar_clone_impl(*grammar);
+    assert(clone != nullptr);
+    assert(clone->failed);
+    llama_token_data cloned_candidates[] = {
+        {0, 0.0f, 0.0f},
+        {1, 1.0f, 0.0f},
+    };
+    llama_token_data_array cloned_cur_p = {
+        /* .data     = */ cloned_candidates,
+        /* .size     = */ 2,
+        /* .selected = */ -1,
+        /* .sorted   = */ false,
+    };
+    llama_grammar_apply_impl(*clone, &cloned_cur_p);
+    for (const auto & candidate : cloned_candidates) {
+        assert(candidate.id == LLAMA_TOKEN_NULL);
+        assert(std::isinf(candidate.logit) && candidate.logit < 0.0f);
+    }
+
+    llama_grammar_free_impl(clone);
+    llama_grammar_free_impl(grammar);
+}
