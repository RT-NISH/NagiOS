diff --git a/tests/test-model-loader-bounds.cpp b/tests/test-model-loader-bounds.cpp
new file mode 100644
--- /dev/null
+++ b/tests/test-model-loader-bounds.cpp
@@ -0,0 +1,40 @@
+#include "llama-model-loader.h"
+
+#include <cstdio>
+#include <limits>
+
+using tensor_weight = llama_model_loader::llama_tensor_weight;
+
+static bool expect_rejected(int tensor_idx, size_t file_size, size_t data_offset,
+        size_t tensor_offset, size_t tensor_size, const char * label) {
+    size_t result = 0x5a5a;
+    if (tensor_weight::checked_data_range(tensor_idx, file_size, data_offset, tensor_offset, tensor_size, result)) {
+        std::fprintf(stderr, "%s: accepted invalid tensor extent\n", label);
+        return false;
+    }
+    if (result != 0x5a5a) {
+        std::fprintf(stderr, "%s: changed the output offset on failure\n", label);
+        return false;
+    }
+    return true;
+}
+
+int main() {
+    size_t result = 0;
+    if (!tensor_weight::checked_data_range(0, 64, 8, 16, 40, result) || result != 24) {
+        std::fprintf(stderr, "valid extent was rejected or returned the wrong offset\n");
+        return 1;
+    }
+
+    if (!expect_rejected(-1, 64, 8, 16, 40, "missing tensor metadata") ||
+            !expect_rejected(0, 64, 65, 0, 0, "data offset beyond EOF") ||
+            !expect_rejected(0, 64, 8, 57, 0, "tensor offset beyond EOF") ||
+            !expect_rejected(0, 64, 8, 16, 41, "tensor data truncated") ||
+            !expect_rejected(0, std::numeric_limits<size_t>::max(),
+                    std::numeric_limits<size_t>::max(), 1, 0, "offset addition overflow")) {
+        return 1;
+    }
+
+    std::puts("test-model-loader-bounds: all checks passed");
+    return 0;
+}
