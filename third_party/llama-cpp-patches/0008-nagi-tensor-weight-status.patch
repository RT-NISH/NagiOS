+bool llama_model_loader::add_tensor_weight(const std::string & name, const llama_file * file, uint16_t idx,
+        const struct gguf_context * gguf_ctx, ggml_tensor * tensor) {
+    if (weights_map.find(name) != weights_map.end()) {
+        LLAMA_LOG_ERROR("%s: invalid model: tensor '%s' is duplicated\n", __func__, ggml_get_name(tensor));
+        tensor_weights_valid = false;
+        return false;
+    }
+
+    llama_tensor_weight weight;
+    if (!weight.init(file, idx, gguf_ctx, tensor)) {
+        tensor_weights_valid = false;
+        return false;
+    }
+
+    if (!weights_map.emplace(name, weight).second) {
+        LLAMA_LOG_ERROR("%s: duplicate tensor weight '%s'\n", __func__, name.c_str());
+        tensor_weights_valid = false;
+        return false;
+    }
+    return true;
