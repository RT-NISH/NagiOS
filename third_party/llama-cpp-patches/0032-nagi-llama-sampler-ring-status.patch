+static bool llama_sampler_has_failed_ring(const struct llama_sampler * smpl) {
+    if (smpl == nullptr || smpl->iface == nullptr) {
+        return false;
+    }
+
+    if (smpl->iface == &llama_sampler_chain_i) {
+        const auto * chain = (const llama_sampler_chain *) smpl->ctx;
+        for (const auto & node : chain->samplers) {
+            if (llama_sampler_has_failed_ring(node.ptr)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    if (smpl->iface == &llama_sampler_penalties_i) {
+        const auto * ctx = (const llama_sampler_penalties *) smpl->ctx;
+        return ctx->prev.failed();
+    }
+
+    if (smpl->iface == &llama_sampler_dry_i) {
+        const auto * ctx = (const llama_sampler_dry *) smpl->ctx;
+        return ctx->last_tokens.failed();
+    }
+
+    return false;
+}
