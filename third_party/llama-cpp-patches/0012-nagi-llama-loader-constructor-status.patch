+static bool invalid_gguf_constructor_status() {
+    FILE * file = std::tmpfile();
+    if (file == nullptr) {
+        std::fprintf(stderr, "cannot create invalid GGUF fixture\n");
+        return false;
+    }
+    const char invalid_header[] = "not a GGUF";
+    if (std::fwrite(invalid_header, 1, sizeof(invalid_header), file) != sizeof(invalid_header) ||
+            std::fseek(file, 0, SEEK_SET) != 0) {
+        std::fprintf(stderr, "cannot write invalid GGUF fixture\n");
+        std::fclose(file);
+        return false;
+    }
+
+    std::vector<std::string> splits;
+    bool failed_closed = false;
+    try {
+        llama_model_loader loader(nullptr, nullptr, nullptr, "", splits, file,
+                LLAMA_LOAD_MODE_NONE, false, false, false, nullptr, nullptr);
+#ifdef __NAGI__
+        failed_closed = !loader.loader_valid;
+#endif
+    } catch (const std::exception & error) {
+#ifdef __NAGI__
+        std::fprintf(stderr, "invalid GGUF constructor threw under __NAGI__: %s\n", error.what());
+#else
+        failed_closed = true;
+#endif
+    }
+    std::fclose(file);
+    if (!failed_closed) {
+        std::fprintf(stderr, "invalid GGUF constructor did not report failure\n");
+    }
+    return failed_closed;
+}
