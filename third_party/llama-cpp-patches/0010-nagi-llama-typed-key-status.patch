+static bool metadata_key_read_status(bool include_wrong_type, bool required,
+        bool expected_metadata_valid, const char * label) {
+    struct gguf_context * metadata = gguf_init_empty();
+    if (metadata == nullptr) {
+        std::fprintf(stderr, "cannot allocate metadata fixture\n");
+        return false;
+    }
+    gguf_set_val_str(metadata, "general.architecture", "llama");
+    if (include_wrong_type) {
+        gguf_set_val_str(metadata, "llama.context_length", "not an integer");
+    }
+
+    std::vector<std::string> splits;
+    bool valid = true;
+    {
+        llama_model_loader loader(metadata, nullptr, nullptr, "", splits, nullptr,
+                LLAMA_LOAD_MODE_NONE, false, false, false, nullptr, nullptr);
+        uint32_t value = 0x5a5a;
+        bool found = false;
+        try {
+            found = loader.get_key(LLM_KV_CONTEXT_LENGTH, value, required);
+        } catch (const std::exception & error) {
+            std::fprintf(stderr, "%s metadata read threw instead of returning status: %s\n", label, error.what());
+            valid = false;
+        }
+        if (found || value != 0x5a5a) {
+            std::fprintf(stderr, "%s metadata read was accepted or changed its output\n", label);
+            valid = false;
+        }
+        if (loader.metadata_valid != expected_metadata_valid) {
+            std::fprintf(stderr, "%s metadata-valid status was %s\n", label,
+                    loader.metadata_valid ? "valid" : "invalid");
+            valid = false;
+        }
+    }
+
+    gguf_free(metadata);
+    return valid;
+}
+
 int main() {
+    if (!metadata_key_read_status(false, false, true, "missing optional") ||
+            !metadata_key_read_status(true, false, false, "wrong-typed optional") ||
+            !metadata_key_read_status(true, true, false, "wrong-typed required")) {
+        return 1;
+    }
+
     size_t result = 0;
     if (!tensor_weight::checked_data_range(0, 64, 8, 16, 40, result) || result != 24) {
         std::fprintf(stderr, "valid extent was rejected or returned the wrong offset\n");
