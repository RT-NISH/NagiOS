+
+static bool malformed_lora_adapter_returns_null() {
+    FILE * file = std::tmpfile();
+    if (file == nullptr) {
+        std::fprintf(stderr, "cannot create malformed LoRA fixture\n");
+        return false;
+    }
+
+    constexpr char malformed_gguf[] = "not a GGUF file";
+    const size_t written = std::fwrite(malformed_gguf, 1, sizeof(malformed_gguf) - 1, file);
+    const bool rewound = std::fseek(file, 0, SEEK_SET) == 0;
+    if (written != sizeof(malformed_gguf) - 1 || !rewound) {
+        std::fprintf(stderr, "cannot initialize malformed LoRA fixture\n");
+        std::fclose(file);
+        return false;
+    }
+
+    llama_model * model = llama_model_create(LLM_ARCH_GROK, llama_model_default_params());
+    if (model == nullptr) {
+        std::fprintf(stderr, "cannot create model for malformed LoRA fixture\n");
+        std::fclose(file);
+        return false;
+    }
+    llama_adapter_lora * adapter = llama_adapter_lora_init_from_file_ptr(model, file);
+    std::fclose(file);
+    if (adapter != nullptr) {
+        llama_adapter_lora_free(adapter);
+        llama_model_free(model);
+        std::fprintf(stderr, "malformed LoRA GGUF unexpectedly initialized\n");
+        return false;
+    }
+
+    llama_model_free(model);
+    return true;
+}
 
