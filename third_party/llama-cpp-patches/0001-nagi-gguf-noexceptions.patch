+#if !defined(_WIN32)
+static std::pair<int, int> test_writer_reports_flush_error() {
+    FILE * file = tmpfile();
+    struct gguf_context * ctx = gguf_init_empty();
+    if (file == nullptr || ctx == nullptr) {
+        if (file != nullptr) {
+            fclose(file);
+        }
+        gguf_free(ctx);
+        printf("test_writer_reports_flush_error: FAIL (setup)\n");
+        return std::make_pair(0, 1);
+    }
+
+    gguf_set_val_u32(ctx, "nagi.writer.flush_probe", 1);
+    if (setvbuf(file, nullptr, _IOFBF, 4096) != 0) {
+        fclose(file);
+        gguf_free(ctx);
+        printf("test_writer_reports_flush_error: FAIL (setvbuf)\n");
+        return std::make_pair(0, 1);
+    }
+
+    const int fd = fileno(file);
+    if (fd < 0 || close(fd) != 0) {
+        fclose(file);
+        gguf_free(ctx);
+        printf("test_writer_reports_flush_error: FAIL (close descriptor)\n");
+        return std::make_pair(0, 1);
+    }
+
+    const bool write_succeeded = gguf_write_to_file_ptr(ctx, file, /*only_meta=*/true);
+    const bool detected_flush_error = !write_succeeded && ferror(file);
+    fclose(file);
+    gguf_free(ctx);
+
+    printf("test_writer_reports_flush_error: %s\n", detected_flush_error ? "OK" : "FAIL");
+    return std::make_pair(detected_flush_error ? 1 : 0, 1);
+}
