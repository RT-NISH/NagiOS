+static bool tensor_count_mismatch_status(bool too_many) {
+    struct gguf_context * metadata = gguf_init_empty();
+    if (metadata == nullptr) {
+        std::fprintf(stderr, "cannot allocate tensor-count fixture\n");
+        return false;
+    }
+    gguf_set_val_str(metadata, "general.architecture", "llama");
+
+    std::vector<std::string> splits;
+    bool failed_closed = false;
+    try {
+        llama_model_loader loader(metadata, nullptr, nullptr, "", splits, nullptr,
+                LLAMA_LOAD_MODE_NONE, false, false, false, nullptr, nullptr);
+        loader.n_tensors = 1;
+        loader.n_created = too_many ? 2 : 0;
+        loader.done_getting_tensors();
+#ifdef __NAGI__
+        failed_closed = !loader.loader_valid;
+#endif
+    } catch (const std::exception & error) {
+#ifdef __NAGI__
+        std::fprintf(stderr, "tensor-count mismatch threw under __NAGI__: %s\n", error.what());
+#else
+        failed_closed = true;
+#endif
+    }
+    gguf_free(metadata);
+    if (!failed_closed) {
+        std::fprintf(stderr, "tensor-count mismatch did not report failure\n");
+    }
+    return failed_closed;
+}
