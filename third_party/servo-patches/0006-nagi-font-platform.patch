+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+//! Nagi's system-font registry boundary.
+//!
+//! Nagi does not expose a host fontconfig, CoreText, or DirectWrite registry.
+//! Until the Nagi font package service is present, this adapter reports the
+//! registry as empty. Web fonts still use the real FreeType backend; no host
+//! font path or guessed system font is inserted into the guest.
+
+use fonts_traits::FontTemplate;
+use style::values::computed::font::GenericFontFamily;
+
+use crate::{FallbackFontSelectionOptions, LowercaseFontFamilyName};
+
+pub(crate) fn for_each_available_family<F>(_callback: F)
+where
+    F: FnMut(String),
+{
+}
+
+pub(crate) fn for_each_variation<F>(_family_name: &str, _callback: F)
+where
+    F: FnMut(FontTemplate),
+{
+}
+
+pub fn fallback_font_families(_options: FallbackFontSelectionOptions) -> Vec<&'static str> {
+    Vec::new()
+}
+
+pub(crate) fn default_system_generic_font_family(
+    _generic: GenericFontFamily,
+) -> LowercaseFontFamilyName {
+    "sans-serif".into()
+}
