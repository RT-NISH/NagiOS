+#[expect(unsafe_code)]
+unsafe extern "C" {
+    fn nagi_m17_console_trace(stage: *const u8, length: usize);
+}
+
+/// Bounded font-path diagnostics on the Nagi guest console.
+pub(crate) fn nagi_font_trace(stage: &str) {
+    use std::sync::atomic::{AtomicUsize, Ordering};
+    static EMITTED: AtomicUsize = AtomicUsize::new(0);
+    if EMITTED.fetch_add(1, Ordering::Relaxed) >= 64 {
+        return;
+    }
+    let line = format!("M18 font {stage}");
+    #[expect(unsafe_code)]
+    unsafe {
+        nagi_m17_console_trace(line.as_ptr(), line.len())
+    }
+}
+
 fn installed(font: &SystemFont) -> bool {
-    std::fs::metadata(font.path).is_ok_and(|metadata| metadata.len() > 0)
+    match std::fs::metadata(font.path) {
+        Ok(metadata) if metadata.len() > 0 => true,
+        Ok(_) => {
+            nagi_font_trace(&format!("system file empty path={}", font.path));
+            false
+        },
+        Err(error) => {
+            nagi_font_trace(&format!("system file missing path={} error={error}", font.path));
+            false
+        },
+    }
 }
 
