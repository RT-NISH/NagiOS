     pub fn send(&self, msg: EmbedderToConstellationMessage) {
+        let is_load_url = matches!(&msg, EmbedderToConstellationMessage::LoadUrl(..));
+        if is_load_url {
+            nagi_m17_trace("M18 ConstellationProxy LoadUrl send started");
+        }
         if self.try_send(msg).is_err() {
+            if is_load_url {
+                nagi_m17_trace("M18 ConstellationProxy LoadUrl send failed");
+            }
             warn!("Lost connection to Constellation. Will report to embedder.")
+        } else if is_load_url {
+            nagi_m17_trace("M18 ConstellationProxy LoadUrl send completed");
         }
     }
 
