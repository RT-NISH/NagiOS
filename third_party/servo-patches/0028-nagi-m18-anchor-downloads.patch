+
+/// Largest download handed to the embedder in one message.
+const MAX_DOWNLOAD_BYTES: usize = 16 * 1024 * 1024;
+
+struct DownloadCspProcessor {
+    global: DomRoot<GlobalScope>,
+}
+
+impl CspViolationsProcessor for DownloadCspProcessor {
+    fn process_csp_violations(&self, cx: &mut JSContext, violations: Vec<Violation>) {
+        self.global.report_csp_violations(cx, violations, None, None);
+    }
+}
+
+impl HTMLAnchorElement {
+    /// <https://html.spec.whatwg.org/multipage/#downloading-hyperlinks>
+    ///
+    /// Downloads `data:`, `blob:`, and same-origin URLs that the user
+    /// activated, fetching them in the document's context and handing the
+    /// bytes to the embedder. Returns `false` when the link should be
+    /// followed instead (for example a cross-origin URL).
+    fn download_hyperlink(&self, cx: &mut JSContext) -> bool {
+        let element = self.as_element();
+        if element.cannot_navigate() {
+            return true;
+        }
+        let document = element.owner_document();
+        let window = document.window();
+        // Downloads require user activation so pages cannot drop files
+        // through script-dispatched clicks.
+        if !window.has_transient_activation() {
+            return true;
+        }
+        let href = element
+            .get_attribute_string_value(&local_name!("href"))
+            .unwrap_or_default();
+        let Ok(url) = document.encoding_parse_a_url(&href) else {
+            return true;
+        };
+        let allowed = matches!(url.scheme(), "data" | "blob") ||
+            *document.origin().immutable() == url.origin();
+        if !allowed {
+            return false;
+        }
+        let global = window.upcast::<GlobalScope>();
+        let request = RequestBuilder::new(
+            global.webview_id(),
+            UrlWithBlobClaim::from_url_without_having_claimed_blob(url.clone()),
+            global.get_referrer(),
+        )
+        .credentials_mode(CredentialsMode::Include)
+        .use_url_credentials(true)
+        .with_global_scope(global);
+        let processor = DownloadCspProcessor {
+            global: DomRoot::from_ref(global),
+        };
+        let Ok((metadata, bytes, _)) = load_whole_resource(
+            request,
+            &global.resource_threads().sender(),
+            global,
+            &processor,
+            cx,
+        ) else {
+            return true;
+        };
+        if !metadata.status.is_success() || bytes.len() > MAX_DOWNLOAD_BYTES {
+            return true;
+        }
+        let attribute = element
+            .get_attribute_string_value(&local_name!("download"))
+            .unwrap_or_default();
+        let suggested_filename = if attribute.trim().is_empty() {
+            url.as_url()
+                .path_segments()
+                .and_then(|mut segments| segments.next_back())
+                .filter(|segment| !segment.is_empty())
+                .unwrap_or("download")
+                .to_owned()
+        } else {
+            attribute.trim().to_owned()
+        };
+        window.send_to_embedder(EmbedderMsg::DownloadRequested(
+            window.webview_id(),
+            DownloadRequest {
+                url: url.into_url(),
+                suggested_filename,
+                bytes,
+            },
+        ));
+        true
+    }
 }
 
