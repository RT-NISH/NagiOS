+use std::ffi::OsStr;
+use std::fs::{self, File, OpenOptions};
+use std::io;
+use std::path::Path;
+
+use crate::util;
+
+pub fn create_named(
+    path: &Path,
+    open_options: &mut OpenOptions,
+    permissions: Option<&std::fs::Permissions>,
+) -> io::Result<File> {
+    use std::os::unix::fs::{OpenOptionsExt, PermissionsExt};
+
+    open_options.read(true).write(true).create_new(true);
+    open_options.mode(permissions.map(|permissions| permissions.mode()).unwrap_or(0o600));
+    open_options.open(path)
+}
+
+fn create_unlinked(path: &Path) -> io::Result<File> {
+    let file = create_named(path, &mut OpenOptions::new(), None)?;
+    let _ = fs::remove_file(path);
+    Ok(file)
+}
+
+pub fn create(dir: &Path) -> io::Result<File> {
+    util::create_helper(
+        dir,
+        OsStr::new(".tmp"),
+        OsStr::new(""),
+        crate::NUM_RAND_CHARS,
+        |path| create_unlinked(&path),
+    )
+}
+
+pub fn reopen(file: &File, _path: &Path) -> io::Result<File> {
+    file.try_clone()
+}
+
+pub fn persist(old_path: &Path, new_path: &Path, overwrite: bool) -> io::Result<()> {
+    if overwrite {
+        fs::rename(old_path, new_path)
+    } else {
+        fs::hard_link(old_path, new_path)?;
+        let _ = fs::remove_file(old_path);
+        Ok(())
+    }
+}
+
+pub fn keep(_: &Path) -> io::Result<()> {
+    Ok(())
+}
