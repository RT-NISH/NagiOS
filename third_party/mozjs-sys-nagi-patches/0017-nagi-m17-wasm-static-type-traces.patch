+  Slot findNonLiveSlot(HashNumber aKeyHash) {
+    MOZ_ASSERT(!(aKeyHash & sCollisionBit));
+    MOZ_ASSERT(mTable);
+
+    // We assume 'aKeyHash' has already been distributed.
+
+    // Compute the primary hash address.
+    HashNumber h1 = hash1(aKeyHash);
+    if constexpr (requires {
+                    AllocPolicy::traceM17FindNonLiveSlotPrimaryIndexComputed();
+                  }) {
+      AllocPolicy::traceM17FindNonLiveSlotPrimaryIndexComputed();
+    }
+    Slot slot = slotForIndex(h1);
+    if constexpr (requires {
+                    AllocPolicy::traceM17FindNonLiveSlotPrimarySlotComputed();
+                  }) {
+      AllocPolicy::traceM17FindNonLiveSlotPrimarySlotComputed();
+    }
+
+    // Miss: return space for a new entry.
+    if constexpr (requires {
+                    AllocPolicy::traceM17FindNonLiveSlotPrimaryLivenessReadStarted();
+                  }) {
+      AllocPolicy::traceM17FindNonLiveSlotPrimaryLivenessReadStarted();
+    }
+    const bool primarySlotIsLive = slot.isLive();
+    if (primarySlotIsLive) {
+      if constexpr (requires {
+                      AllocPolicy::traceM17FindNonLiveSlotPrimarySlotIsLive();
+                    }) {
+        AllocPolicy::traceM17FindNonLiveSlotPrimarySlotIsLive();
+      }
+    } else {
+      if constexpr (requires {
+                      AllocPolicy::traceM17FindNonLiveSlotPrimarySlotIsFree();
+                    }) {
+        AllocPolicy::traceM17FindNonLiveSlotPrimarySlotIsFree();
+      }
+    }
+    if (!primarySlotIsLive) {
+      return slot;
+    }
+
+    // Collision: double hash.
+    if constexpr (requires {
+                    AllocPolicy::traceM17FindNonLiveSlotCollisionPathEntered();
+                  }) {
+      AllocPolicy::traceM17FindNonLiveSlotCollisionPathEntered();
+    }
+    DoubleHash dh = hash2(aKeyHash);
+    if constexpr (requires {
+                    AllocPolicy::traceM17FindNonLiveSlotHash2Computed();
+                  }) {
+      AllocPolicy::traceM17FindNonLiveSlotHash2Computed();
+    }
+
+    bool traceFirstProbe = true;
+    while (true) {
+      slot.setCollision();
+      if (traceFirstProbe) {
+        if constexpr (requires {
+                        AllocPolicy::traceM17FindNonLiveSlotFirstCollisionMarkCompleted();
+                      }) {
+          AllocPolicy::traceM17FindNonLiveSlotFirstCollisionMarkCompleted();
+        }
+      }
+
+      h1 = applyDoubleHash(h1, dh);
+
+      slot = slotForIndex(h1);
+      if (traceFirstProbe) {
+        if constexpr (requires {
+                        AllocPolicy::traceM17FindNonLiveSlotFirstProbeSlotComputed();
+                      }) {
+          AllocPolicy::traceM17FindNonLiveSlotFirstProbeSlotComputed();
+        }
+        if constexpr (requires {
+                        AllocPolicy::traceM17FindNonLiveSlotFirstProbeLivenessReadStarted();
+                      }) {
+          AllocPolicy::traceM17FindNonLiveSlotFirstProbeLivenessReadStarted();
+        }
+      }
+      const bool slotIsLive = slot.isLive();
+      if (traceFirstProbe) {
+        if (slotIsLive) {
+          if constexpr (requires {
+                          AllocPolicy::traceM17FindNonLiveSlotFirstProbeSlotIsLive();
+                        }) {
+            AllocPolicy::traceM17FindNonLiveSlotFirstProbeSlotIsLive();
+          }
+        } else {
+          if constexpr (requires {
+                          AllocPolicy::traceM17FindNonLiveSlotFirstProbeSlotIsFree();
+                        }) {
+            AllocPolicy::traceM17FindNonLiveSlotFirstProbeSlotIsFree();
+          }
+        }
+        traceFirstProbe = false;
+      }
+      if (!slotIsLive) {
+        return slot;
+      }
+    }
+  }
