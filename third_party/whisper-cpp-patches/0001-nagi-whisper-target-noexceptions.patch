--- /dev/null
+++ b/tests/test-gguf-nagi.cpp
@@ -0,0 +1,164 @@
+#include "gguf.h"
+
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <iostream>
+#include <vector>
+
+#if !defined(_WIN32)
+#    include <csignal>
+#    include <sys/resource.h>
+#    include <sys/wait.h>
+#    include <unistd.h>
+#endif
+
+namespace {
+
+void check(bool condition, const char * message) {
+    if (!condition) {
+        std::cerr << "FAIL Nagi GGUF test: " << message << '\n';
+        std::abort();
+    }
+}
+
+struct fixture_reader {
+    const std::vector<uint8_t> * bytes;
+};
+
+size_t read_fixture(void * userdata, void * output, uint64_t offset, size_t size) {
+    const auto * reader = static_cast<const fixture_reader *>(userdata);
+    if (offset >= reader->bytes->size()) {
+        return 0;
+    }
+    const size_t available = reader->bytes->size() - static_cast<size_t>(offset);
+    const size_t copied = size < available ? size : available;
+    std::memcpy(output, reader->bytes->data() + offset, copied);
+    return copied;
+}
+
+void append_u32(std::vector<uint8_t> & bytes, uint32_t value) {
+    for (size_t i = 0; i < sizeof(value); ++i) {
+        bytes.push_back(static_cast<uint8_t>(value >> (i * 8)));
+    }
+}
+
+void append_u64(std::vector<uint8_t> & bytes, uint64_t value) {
+    for (size_t i = 0; i < sizeof(value); ++i) {
+        bytes.push_back(static_cast<uint8_t>(value >> (i * 8)));
+    }
+}
+
+void append_string(std::vector<uint8_t> & bytes, const char * value) {
+    const size_t size = std::strlen(value);
+    append_u64(bytes, size);
+    bytes.insert(bytes.end(), value, value + size);
+}
+
+std::vector<uint8_t> header(uint64_t n_tensors, uint64_t n_kv) {
+    std::vector<uint8_t> bytes{'G', 'G', 'U', 'F'};
+    append_u32(bytes, GGUF_VERSION);
+    append_u64(bytes, n_tensors);
+    append_u64(bytes, n_kv);
+    return bytes;
+}
+
+struct gguf_context * parse(const std::vector<uint8_t> & bytes) {
+    fixture_reader reader{&bytes};
+    gguf_init_params params{};
+    params.no_alloc = true;
+    return gguf_init_from_callback(read_fixture, &reader, 4096, bytes.size(), params);
+}
+
+void test_header_count_limits() {
+    auto too_many_tensors = header(32 * 1024 + 1, 0);
+    check(parse(too_many_tensors) == nullptr, "reject tensor count above Nagi limit");
+
+    auto too_many_keys = header(0, 4 * 1024 + 1);
+    check(parse(too_many_keys) == nullptr, "reject key count above Nagi limit");
+}
+
+void test_string_array_and_total_metadata_limits() {
+    auto oversized_string = header(0, 1);
+    append_string(oversized_string, "key");
+    append_u32(oversized_string, GGUF_TYPE_STRING);
+    append_u64(oversized_string, 1024 * 1024 + 1);
+    check(parse(oversized_string) == nullptr, "reject string above Nagi limit");
+
+    auto oversized_array = header(0, 1);
+    append_string(oversized_array, "key");
+    append_u32(oversized_array, GGUF_TYPE_ARRAY);
+    append_u32(oversized_array, GGUF_TYPE_UINT8);
+    append_u64(oversized_array, 1024 * 1024 + 1);
+    check(parse(oversized_array) == nullptr, "reject array above Nagi limit");
+
+    auto oversized_metadata = header(0, 1);
+    append_string(oversized_metadata, "key");
+    append_u32(oversized_metadata, GGUF_TYPE_ARRAY);
+    append_u32(oversized_metadata, GGUF_TYPE_UINT8);
+    append_u64(oversized_metadata, 4096);
+    oversized_metadata.resize(oversized_metadata.size() + 4096, 0);
+    check(parse(oversized_metadata) == nullptr, "reject metadata above configured byte limit");
+}
+
+void test_valid_parse_and_write_failure() {
+    auto bytes = header(0, 1);
+    append_string(bytes, "nagi.test");
+    append_u32(bytes, GGUF_TYPE_UINT32);
+    append_u32(bytes, 42);
+    gguf_context * parsed = parse(bytes);
+    check(parsed != nullptr, "parse valid bounded metadata");
+    check(gguf_get_n_kv(parsed) == 1, "preserve valid key count");
+    check(gguf_get_val_u32(parsed, 0) == 42, "preserve valid scalar value");
+    gguf_free(parsed);
+
+    gguf_context * ctx = gguf_init_empty();
+    check(ctx != nullptr, "create writer context");
+    gguf_set_val_str(ctx, "nagi.test", "bounded writer");
+
+#if !defined(_WIN32)
+    char path[] = "/tmp/nagi-gguf-write-failure-XXXXXX";
+    const int fd = mkstemp(path);
+    check(fd >= 0, "create failing output file");
+    close(fd);
+
+    const pid_t child = fork();
+    check(child >= 0, "create writer failure test process");
+    if (child == 0) {
+        struct rlimit file_limit {};
+        if (getrlimit(RLIMIT_FSIZE, &file_limit) != 0) {
+            _exit(2);
+        }
+        file_limit.rlim_cur = 0;
+        if (setrlimit(RLIMIT_FSIZE, &file_limit) != 0 || std::signal(SIGXFSZ, SIG_IGN) == SIG_ERR) {
+            _exit(3);
+        }
+        FILE * file = std::fopen(path, "wb");
+        if (!file) {
+            _exit(4);
+        }
+        std::setvbuf(file, nullptr, _IONBF, 0);
+        const bool write_ok = gguf_write_to_file_ptr(ctx, file, true);
+        std::fclose(file);
+        _exit(write_ok ? 5 : 0);
+    }
+
+    int status = 0;
+    check(waitpid(child, &status, 0) == child, "wait for writer failure test process");
+    check(WIFEXITED(status) && WEXITSTATUS(status) == 0, "return failure for short output writes");
+    std::remove(path);
+#endif
+
+    gguf_free(ctx);
+}
+
+} // namespace
+
+int main() {
+    test_header_count_limits();
+    test_string_array_and_total_metadata_limits();
+    test_valid_parse_and_write_failure();
+    std::cout << "PASS Nagi GGUF metadata bounds and writer failure handling\n";
+    return 0;
+}
