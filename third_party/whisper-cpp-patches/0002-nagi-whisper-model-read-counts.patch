+enum class ModelReadStatus {
+    Complete,
+    Stalled,
+    InvalidCount,
+};
+
+static ModelReadStatus read_model_data(whisper_model_loader * loader,
+                                       void * output,
+                                       size_t read_size,
+                                       size_t & bytes_read) {
+    bytes_read = 0;
+    auto * destination = static_cast<uint8_t *>(output);
+    while (bytes_read < read_size) {
+        const size_t remaining = read_size - bytes_read;
+        const size_t count = loader->read(loader->context, destination + bytes_read, remaining);
+        if (count > remaining) {
+            return ModelReadStatus::InvalidCount;
+        }
+        if (count == 0) {
+            return ModelReadStatus::Stalled;
+        }
+        bytes_read += count;
+    }
+    return ModelReadStatus::Complete;
+}
+
+static bool read_model_bytes(whisper_model_loader * loader, void * output, size_t read_size) {
+    size_t bytes_read = 0;
+    if (read_model_data(loader, output, read_size, bytes_read) != ModelReadStatus::Complete) {
+        WHISPER_LOG_ERROR("%s: truncated model file (expected %zu bytes, read %zu)\n",
+                          __func__, read_size, bytes_read);
+        return false;
+    }
+    return true;
+}
+
+template<typename T>
+static bool read_safe_model_value(whisper_model_loader * loader, T & dest) {
+    if (!read_model_bytes(loader, &dest, sizeof(T))) {
+        return false;
+    }
+    BYTESWAP_VALUE(dest);
+    return true;
+}
