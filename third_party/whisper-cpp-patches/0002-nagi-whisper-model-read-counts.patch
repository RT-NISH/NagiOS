+    auto initialize_from_source = [&cparams](partial_model_source & source) {
+        whisper_model_loader loader = {};
+        loader.context = &source;
+        loader.read = [](void * context, void * output, size_t read_size) {
+            partial_model_source * input = static_cast<partial_model_source *>(context);
+            input->read_calls++;
+            const size_t available = input->size - input->offset;
+            size_t bytes_to_copy = available < read_size ? available : read_size;
+            if (bytes_to_copy > input->max_chunk) {
+                bytes_to_copy = input->max_chunk;
+            }
+            if (bytes_to_copy != 0) {
+                std::memcpy(output, input->bytes + input->offset, bytes_to_copy);
+                input->offset += bytes_to_copy;
+            }
+            return bytes_to_copy;
+        };
+        loader.eof = [](void * context) {
+            partial_model_source * input = static_cast<partial_model_source *>(context);
+            return input->offset >= input->size;
+        };
+        loader.close = [](void *) {};
+        return whisper_init_with_params_no_state(&loader, cparams);
+    };
