diff --git a/src/gallium/targets/pipe-loader/meson.build b/src/gallium/targets/pipe-loader/meson.build
index 4a28f9f9c1e..f5d1ec0b7a2 100644
--- a/src/gallium/targets/pipe-loader/meson.build
+++ b/src/gallium/targets/pipe-loader/meson.build
@@ -87,0 +88,15 @@ endforeach
+if with_platform_nagi
+  # The static EGL path uses pipe_loader_static directly.  Upstream's
+  # public sw helper is normally supplied by a shared pipe_swrast target,
+  # which is not part of the Nagi static archive graph.  Compile the pinned
+  # Mesa helper into a target-owned archive so sw_screen_create_vk is a real
+  # Softpipe entry point, not an adapter stub.
+  libpipe_loader_nagi_roots = static_library(
+    'pipe_loader_nagi_roots',
+    'nagi_roots.c',
+    include_directories : pipe_loader_incs,
+    c_args : ['-DGALLIUM_SOFTPIPE'],
+    dependencies : [driver_swrast, idep_mesautil],
+    build_by_default : false,
+  )
+endif
