diff --git a/src/egl/main/eglcurrent.c b/src/egl/main/eglcurrent.c
index 2a1a01d7aee..cab4afa36c9 100644
--- a/src/egl/main/eglcurrent.c
+++ b/src/egl/main/eglcurrent.c
@@ -42,0 +43 @@
+#define EGL_CURRENT_NAGI_THREAD_INFO_COOKIE UINT64_C(0x4e41474945474c54)
@@ -74,0 +76,10 @@ _eglGetCurrentThread(void)
+#ifdef __NAGI__
+   if (unlikely(!current->inited ||
+                current->NagiInitCookie !=
+                   EGL_CURRENT_NAGI_THREAD_INFO_COOKIE)) {
+      if (unlikely(current->NagiInitCookie !=
+                   EGL_CURRENT_NAGI_THREAD_INFO_COOKIE)) {
+         EGL_CURRENT_NAGI_TRACE_STATE("thread-info init cookie mismatch",
+                                      current, current->CurrentContext);
+      }
+#else
@@ -75,0 +87 @@ _eglGetCurrentThread(void)
+#endif
@@ -79,0 +92,3 @@ _eglGetCurrentThread(void)
+#ifdef __NAGI__
+      current->NagiInitCookie = EGL_CURRENT_NAGI_THREAD_INFO_COOKIE;
+#endif
