diff --git a/src/gallium/drivers/softpipe/sp_state_sampler.c b/src/gallium/drivers/softpipe/sp_state_sampler.c
index c20de39a881..54425fff3a4 100644
--- a/src/gallium/drivers/softpipe/sp_state_sampler.c
+++ b/src/gallium/drivers/softpipe/sp_state_sampler.c
@@ -34,0 +35,4 @@
+#ifdef __NAGI__
+#include "util/os_misc.h"
+#include "util/u_debug.h"
+#endif
@@ -97,0 +102,38 @@ softpipe_sampler_view_destroy(struct pipe_context *pipe,
+#ifdef __NAGI__
+static void
+softpipe_update_tex_cache(struct softpipe_context *softpipe,
+                          enum pipe_shader_type shader,
+                          unsigned slot,
+                          struct pipe_sampler_view *view)
+{
+   struct softpipe_tex_tile_cache **cache = &softpipe->tex_cache[shader][slot];
+
+   if (view && !*cache) {
+      *cache = sp_create_tex_tile_cache(&softpipe->pipe);
+      if (!*cache) {
+         debug_printf("Nagi Softpipe: out of memory creating a bound texture cache\n");
+         os_abort();
+      }
+   }
+
+   if (!*cache)
+      return;
+
+   sp_tex_tile_cache_set_sampler_view(*cache, view);
+   if (!view) {
+      sp_destroy_tex_tile_cache(*cache);
+      *cache = NULL;
+   }
+}
+#else
+static void
+softpipe_update_tex_cache(struct softpipe_context *softpipe,
+                          enum pipe_shader_type shader,
+                          unsigned slot,
+                          struct pipe_sampler_view *view)
+{
+   sp_tex_tile_cache_set_sampler_view(softpipe->tex_cache[shader][slot], view);
+}
+#endif
+
+
