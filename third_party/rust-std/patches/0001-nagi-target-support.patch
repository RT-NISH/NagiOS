diff --git a/library/std/src/sys/random/nagi.rs b/library/std/src/sys/random/nagi.rs
new file mode 100644
index 0000000..d66b79a
--- /dev/null
+++ b/library/std/src/sys/random/nagi.rs
@@ -0,0 +1,8 @@
+unsafe extern "C" {
+    fn __nagi_std_random_fill(destination: *mut u8, length: usize) -> i32;
+}
+
+pub fn fill_bytes(bytes: &mut [u8]) {
+    let result = unsafe { __nagi_std_random_fill(bytes.as_mut_ptr(), bytes.len()) };
+    assert_eq!(result, 0, "failed to generate random data");
+}
