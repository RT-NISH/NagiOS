#!/usr/bin/env sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cargo_path=$(command -v cargo || true)
rustup_path=$(command -v rustup || true)
if [ -n "$rustup_path" ]; then
    toolchain=$(sed -n 's/^[[:space:]]*channel[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$script_dir/rust-toolchain.toml")
    if [ -n "$toolchain" ]; then
        pinned_cargo=$("$rustup_path" which cargo --toolchain "$toolchain" 2>/dev/null || true)
        pinned_rustc=$("$rustup_path" which rustc --toolchain "$toolchain" 2>/dev/null || true)
        pinned_rustdoc=$("$rustup_path" which rustdoc --toolchain "$toolchain" 2>/dev/null || true)
        if [ -n "$pinned_cargo" ] && [ -n "$pinned_rustc" ] && [ -n "$pinned_rustdoc" ]; then
            cargo_path=$pinned_cargo
            export RUSTC=$pinned_rustc
            export RUSTDOC=$pinned_rustdoc
        fi
    fi
fi
if [ -z "$cargo_path" ]; then
    printf '%s\n' 'FAIL cannot start nagi: Cargo was not found; install the toolchain from rust-toolchain.toml' >&2
    exit 4
fi
if [ -x "/c/Program Files/LLVM/bin/lld-link.exe" ]; then
    export RUSTC_LINKER='C:/Program Files/LLVM/bin/lld-link.exe'
    export CARGO_TARGET_X86_64_PC_WINDOWS_MSVC_LINKER='C:/Program Files/LLVM/bin/lld-link.exe'
    export LIB='C:/Program Files (x86)/Microsoft Visual Studio/2022/BuildTools/VC/Tools/MSVC/14.44.35207/lib/x64;C:/Program Files (x86)/Windows Kits/10/Lib/10.0.26100.0/um/x64;C:/Program Files (x86)/Windows Kits/10/Lib/10.0.26100.0/ucrt/x64'
fi
case "${1:-}" in
fetch|dev)
    exec "$cargo_path" run --locked --manifest-path "$script_dir/tools/nagi-bootstrap/Cargo.toml" -p nagi-bootstrap -- "$@"
    ;;
esac
exec "$cargo_path" run --locked --manifest-path "$script_dir/Cargo.toml" -p nagi-cli -- "$@"
